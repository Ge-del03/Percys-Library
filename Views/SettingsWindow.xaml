<Window x:Class="ComicReader.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:ComicReader.Views"
    xmlns:vm="clr-namespace:ComicReader.ViewModels"
    xmlns:cmd="clr-namespace:System.Windows.Input;assembly=PresentationCore"
    xmlns:conv="clr-namespace:ComicReader.Converters"
    Title="Configuración" Height="720" Width="1000" WindowStartupLocation="CenterOwner" Background="#FFF">

    <!-- Datos: el ViewModel se instancia aquí para facilitar testing y preview -->
    <Window.DataContext>
        <vm:SettingsViewModel />
    </Window.DataContext>

    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding ApplyCommand}" />
        <KeyBinding Gesture="Ctrl+Alt+P" Command="{Binding PreviewCommand}" />
    <!-- Escape cierra la ventana: usar ApplicationCommands.Close si está disponible -->
    <KeyBinding Gesture="Esc" Command="{x:Static cmd:ApplicationCommands.Close}" />
    </Window.InputBindings>

    <Grid x:Name="RootGrid" Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar (simple y seguro) -->
    <Border x:Name="SidebarBorder" Grid.Column="0" Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="8" Padding="12" Margin="4">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Configuración" FontSize="18" FontWeight="Bold" Foreground="#FFF" />
                    <TextBlock Text="Opciones" Margin="0,4,0,12" Foreground="#BFC9D2" />
                </StackPanel>

                <ListBox ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection, Mode=TwoWay}" BorderThickness="0" Background="Transparent" Foreground="#FFF" x:Name="SidebarList">
                    <ListBox.Resources>
                        <conv:SectionToIconConverter x:Key="SectionIcon" />
                    </ListBox.Resources>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,6,0,6" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <!-- Pill-like item -->
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="14" Padding="6" SnapsToDevicePixels="True" RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="1" ScaleY="1" />
                                            </Border.RenderTransform>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="56" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <!-- circle indicator area: ellipse behind the emoji so it doesn't cover it -->
                                                <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <Ellipse Width="22" Height="22" Fill="#2F2F2F" x:Name="IndicatorOuter" Opacity="0.0" />
                                                    <TextBlock x:Name="IconText" Text="{Binding Converter={StaticResource SectionIcon}}" FontSize="16" Foreground="{StaticResource IconAccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" Background="Transparent" />
                                                </Grid>

                                                <TextBlock Grid.Column="1" Text="{Binding}" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="8,0,0,0" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryBrushDark}" />
                                                <Setter TargetName="IconText" Property="Opacity" Value="1" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                                <Setter TargetName="IconText" Property="Foreground" Value="White" />
                                                <Setter TargetName="IndicatorOuter" Property="Opacity" Value="1" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <!-- Action buttons moved to the bottom area (empty space) -->
                <StackPanel DockPanel.Dock="Bottom" Margin="12" HorizontalAlignment="Stretch" VerticalAlignment="Bottom">
                    <Border Background="Transparent" Margin="0,6,0,6" Padding="2">
                        <Grid Height="44">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="14" Height="14" Fill="{StaticResource IconAccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8,0" />
                            <Button Grid.Column="1" Style="{StaticResource ButtonComic}" Content="Previsualizar" Command="{Binding PreviewCommand}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        </Grid>
                    </Border>

                    <Border Background="Transparent" Margin="0,6,0,6" Padding="2">
                        <Grid Height="44">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="14" Height="14" Fill="{StaticResource IconAccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8,0" />
                            <Button Grid.Column="1" Style="{StaticResource ButtonComic}" Content="Aplicar" Command="{Binding ApplyCommand}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        </Grid>
                    </Border>

                    <Border Background="Transparent" Margin="0,6,0,6" Padding="2">
                        <Grid Height="44">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="14" Height="14" Fill="{StaticResource IconAccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8,0" />
                            <Button Grid.Column="1" Style="{StaticResource ButtonComic}" Content="Guardar" Command="{Binding SaveCommand}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        </Grid>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Content area: contenedor seguro para SettingsHub -->
        <Border x:Name="ContentBorder" Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" Padding="12" CornerRadius="8" Margin="4" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1">
            <local:SettingsHub x:Name="SettingsHubControl" />
        </Border>
    </Grid>
</Window>
