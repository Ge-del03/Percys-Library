<Window x:Class="ComicReader.Views.ModernCollectionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewmodels="clr-namespace:ComicReader.ViewModels"
        Title="Percy's Collections Pro" 
        Height="900" Width="1400"
        MinHeight="700" MinWidth="1200"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA"
        ShowInTaskbar="True"
        Topmost="False">

    <Window.DataContext>
        <viewmodels:AdvancedCollectionsViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <ResourceDictionary>

            <!-- Convertidores -->
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <!-- Estilos personalizados -->
            <Style x:Key="CollectionCardStyle" TargetType="materialDesign:Card">
                <Setter Property="Margin" Value="8"/>
                <Setter Property="Padding" Value="16"/>
                <Setter Property="UniformCornerRadius" Value="8"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp8"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ComicItemCardStyle" TargetType="materialDesign:Card">
                <Setter Property="Margin" Value="12"/>
                <Setter Property="Width" Value="320"/>
                <Setter Property="Height" Value="180"/>
                <Setter Property="UniformCornerRadius" Value="12"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp16"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

        </ResourceDictionary>
    </Window.Resources>

    <materialDesign:DialogHost Identifier="RootDialog" CloseOnClickAway="True">
        <Grid>
            <!-- Window chrome personalizado -->
            <Border Background="{DynamicResource MaterialDesignPaper}" 
                    CornerRadius="12" 
                    materialDesign:ElevationAssist.Elevation="Dp4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Title Bar -->
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="*"/> <!-- Content -->
                        <RowDefinition Height="Auto"/> <!-- Status Bar -->
                    </Grid.RowDefinitions>

                    <!-- Custom Title Bar -->
                    <Grid Grid.Row="0" Background="{DynamicResource PrimaryHueMidBrush}" 
                          MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Margin="16,8">
                            <materialDesign:PackIcon Kind="StarCircle" Width="28" Height="28" 
                                                     Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Text="Percy's Collections Pro" FontSize="18" FontWeight="Bold" 
                                       Foreground="White" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,8,0">
                            <Button Style="{StaticResource MaterialDesignIconButton}" Click="MinimizeWindow_Click"
                                    Width="40" Height="40" Padding="0">
                                <materialDesign:PackIcon Kind="WindowMinimize" Foreground="White"/>
                            </Button>
                            <Button Style="{StaticResource MaterialDesignIconButton}" Click="MaximizeWindow_Click"
                                    Width="40" Height="40" Padding="0">
                                <materialDesign:PackIcon Kind="WindowMaximize" Foreground="White"/>
                            </Button>
                            <Button Style="{StaticResource MaterialDesignIconButton}" Click="CloseWindow_Click"
                                    Width="40" Height="40" Padding="0">
                                <materialDesign:PackIcon Kind="Close" Foreground="White"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Header con búsqueda y acciones globales -->
                    <materialDesign:Card Grid.Row="1" Margin="16,16,16,8" UniformCornerRadius="8">
                        <Grid Margin="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal">
                                <TextBox materialDesign:HintAssist.Hint="Buscar en colecciones..." 
                                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                         Width="400" Margin="0,0,16,0"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}">
                                    <materialDesign:TextFieldAssist.LeadingIcon>
                                        <materialDesign:PackIcon Kind="Magnify"/>
                                    </materialDesign:TextFieldAssist.LeadingIcon>
                                </TextBox>

                                <ComboBox materialDesign:HintAssist.Hint="Ordenar por" 
                                          ItemsSource="{Binding SortOptions}"
                                          SelectedItem="{Binding SelectedSortOption}"
                                          Width="160" Margin="0,0,16,0"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"/>

                                <ToggleButton Style="{StaticResource MaterialDesignActionAccentToggleButton}"
                                              IsChecked="{Binding SortDescending}"
                                              ToolTip="Orden descendente"
                                              Width="40" Height="40">
                                    <materialDesign:PackIcon Kind="SortDescending"/>
                                </ToggleButton>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Command="{Binding CreateCollectionCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FolderPlus" VerticalAlignment="Center"/>
                                        <TextBlock Text="Nueva Colección" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding ExportCollectionCommand}" 
                                        CommandParameter="json"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Export" VerticalAlignment="Center"/>
                                        <TextBlock Text="Exportar" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>

                                <Button Click="ImportCollection_Click"
                                        Style="{StaticResource MaterialDesignOutlinedButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Import" VerticalAlignment="Center"/>
                                        <TextBlock Text="Importar" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </materialDesign:Card>

                    <!-- Contenido Principal -->
                    <Grid Grid.Row="2" Margin="16,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="350"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="350"/>
                        </Grid.ColumnDefinitions>

                        <!-- Panel Izquierdo: Lista de Colecciones -->
                        <materialDesign:Card Grid.Column="0" Margin="0,0,8,0" UniformCornerRadius="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Header -->
                                <Border Background="{DynamicResource PrimaryHueLightBrush}" 
                                        Padding="20,16" CornerRadius="12,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="📚 Mis Colecciones" FontSize="20" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Collections.Count, StringFormat='{}{0} colecciones'}"
                                                   Opacity="0.8" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Lista de colecciones -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Collections}" Margin="8">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <materialDesign:Card Style="{StaticResource CollectionCardStyle}"
                                                                     Cursor="Hand"
                                                                     MouseLeftButtonDown="Collection_Selected">
                                                    <materialDesign:Card.Resources>
                                                        <Style TargetType="materialDesign:Card" BasedOn="{StaticResource CollectionCardStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource PrimaryHueLightBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </materialDesign:Card.Resources>

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Color Indicator -->
                                                        <Border Width="4" Background="{Binding Color}" 
                                                                CornerRadius="2" Margin="0,0,12,0"/>

                                                        <!-- Info -->
                                                        <StackPanel Grid.Column="1">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Icon}" FontSize="16" 
                                                                           Margin="0,0,8,0"/>
                                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" 
                                                                           FontSize="15"/>
                                                            </StackPanel>
                                                            
                                                            <TextBlock Text="{Binding Description}" 
                                                                       TextWrapping="Wrap" Opacity="0.7"
                                                                       MaxHeight="40" Margin="0,4,0,0"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            
                                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                                <materialDesign:PackIcon Kind="Book" Width="16" Height="16" 
                                                                                         Opacity="0.6" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding ItemCount, StringFormat='{}{0} cómics'}" 
                                                                           FontSize="12" Opacity="0.6" Margin="4,0,0,0"/>
                                                            </StackPanel>

                                                            <ProgressBar Value="{Binding CompletionPercentage}" 
                                                                         Maximum="100" Height="4" Margin="0,8,0,0"
                                                                         Foreground="{DynamicResource SecondaryHueMidBrush}"/>
                                                        </StackPanel>

                                                        <!-- Pin Indicator -->
                                                        <materialDesign:PackIcon Grid.Column="2" Kind="Pin" 
                                                                                 Width="20" Height="20"
                                                                                 Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}"
                                                                                 Foreground="{DynamicResource SecondaryHueMidBrush}"/>
                                                    </Grid>
                                                </materialDesign:Card>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <!-- Estadísticas -->
                                <Border Grid.Row="2" Background="{DynamicResource MaterialDesignDivider}" 
                                        Padding="20,16" CornerRadius="0,0,12,12">
                                    <Grid DataContext="{Binding Statistics}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding TotalItems, StringFormat='{}{0} cómics'}" 
                                                       FontWeight="Bold" FontSize="16"/>
                                            <TextBlock Text="Total" Opacity="0.6" FontSize="11"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding CompletedItems}" 
                                                       FontWeight="Bold" FontSize="16"/>
                                            <TextBlock Text="Completados" Opacity="0.6" FontSize="11"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </materialDesign:Card>

                        <!-- Panel Central: Ítems de la Colección -->
                        <materialDesign:Card Grid.Column="1" Margin="8,0" UniformCornerRadius="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Header de colección seleccionada -->
                                <Border Background="{DynamicResource PrimaryHueLightBrush}" 
                                        Padding="24,20" CornerRadius="12,12,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="{Binding SelectedCollection.Name, FallbackValue='Selecciona una colección'}" 
                                                       FontSize="22" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding FilteredItems.Count, StringFormat='{}{0} cómics'}"
                                                       Opacity="0.7" Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Command="{Binding AddItemsToCollectionCommand}" 
                                                    Click="AddComics_Click"
                                                    Style="{StaticResource MaterialDesignRaisedSecondaryButton}"
                                                    Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="Plus"/>
                                                    <TextBlock Text="Agregar" Margin="8,0,0,0"/>
                                                </StackPanel>
                                            </Button>

                                            <Button Command="{Binding DuplicateCollectionCommand}"
                                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                                    Margin="0,0,8,0"
                                                    ToolTip="Duplicar colección">
                                                <materialDesign:PackIcon Kind="ContentCopy"/>
                                            </Button>

                                            <Button Command="{Binding TogglePinCommand}"
                                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                                    Margin="0,0,8,0"
                                                    ToolTip="Fijar colección">
                                                <materialDesign:PackIcon Kind="Pin"/>
                                            </Button>

                                            <Button Command="{Binding DeleteCollectionCommand}"
                                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                                    Foreground="{DynamicResource ValidationErrorBrush}"
                                                    ToolTip="Eliminar colección">
                                                <materialDesign:PackIcon Kind="Delete"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Filtros avanzados -->
                                <Expander Grid.Row="1" Header="🔍 Filtros Avanzados" Margin="16,8">
                                    <Grid Margin="0,12,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <ComboBox Grid.Column="0" materialDesign:HintAssist.Hint="Filtrar por etiqueta"
                                                  ItemsSource="{Binding AvailableTags}"
                                                  SelectedItem="{Binding SelectedTagFilter}"
                                                  Margin="0,0,8,0"
                                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"/>

                                        <ComboBox Grid.Column="1" materialDesign:HintAssist.Hint="Rating mínimo"
                                                  SelectedItem="{Binding MinimumRating}"
                                                  Margin="8,0,8,0"
                                                  Style="{StaticResource MaterialDesignOutlinedComboBox}">
                                            <ComboBoxItem Content="Cualquiera" Tag="{x:Null}"/>
                                            <ComboBoxItem Content="⭐ 1+" Tag="1"/>
                                            <ComboBoxItem Content="⭐⭐ 2+" Tag="2"/>
                                            <ComboBoxItem Content="⭐⭐⭐ 3+" Tag="3"/>
                                            <ComboBoxItem Content="⭐⭐⭐⭐ 4+" Tag="4"/>
                                            <ComboBoxItem Content="⭐⭐⭐⭐⭐ 5" Tag="5"/>
                                        </ComboBox>

                                        <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                            <CheckBox Content="Solo completados" 
                                                      IsChecked="{Binding ShowCompletedOnly}"
                                                      Margin="0,0,0,8"/>
                                            <CheckBox Content="Solo favoritos" 
                                                      IsChecked="{Binding ShowFavoritesOnly}"/>
                                        </StackPanel>
                                    </Grid>
                                </Expander>

                                <!-- Grid de cómics -->
                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding FilteredItems}" Margin="12">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <materialDesign:Card Style="{StaticResource ComicItemCardStyle}"
                                                                     Cursor="Hand"
                                                                     MouseLeftButtonDown="Comic_DoubleClick">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="110"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Thumbnail -->
                                                        <Border CornerRadius="8" ClipToBounds="True"
                                                                Background="{DynamicResource MaterialDesignDivider}">
                                                            <Image Source="{Binding ThumbnailPath}" 
                                                                   Stretch="UniformToFill"
                                                                   Width="100" Height="140"/>
                                                        </Border>

                                                        <!-- Info -->
                                                        <StackPanel Grid.Column="1" Margin="16,8,8,8">
                                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" 
                                                                       FontSize="14" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Author}" Opacity="0.7" 
                                                                       FontSize="12" Margin="0,4,0,0"
                                                                       TextTrimming="CharacterEllipsis"/>

                                                            <!-- Rating -->
                                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                                <materialDesign:PackIcon Kind="Star" 
                                                                                         Width="16" Height="16"
                                                                                         Foreground="{DynamicResource SecondaryHueMidBrush}"/>
                                                                <TextBlock Text="{Binding Rating}" FontSize="12" Margin="4,0"/>
                                                            </StackPanel>

                                                            <!-- Progress -->
                                                            <Grid Margin="0,8,0,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <ProgressBar Value="{Binding Progress}" Maximum="100" 
                                                                             Height="6" VerticalAlignment="Center"
                                                                             Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding Progress, StringFormat='{}{0:F0}%'}" 
                                                                           FontSize="11" Opacity="0.6" Margin="8,0,0,0"/>
                                                            </Grid>

                                                            <!-- Tags -->
                                                            <ItemsControl ItemsSource="{Binding Tags}" Margin="0,8,0,0">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel Orientation="Horizontal"/>
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Background="{DynamicResource PrimaryHueLightBrush}"
                                                                                CornerRadius="10" Padding="8,2" Margin="0,0,4,4">
                                                                            <TextBlock Text="{Binding}" FontSize="10"/>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>

                                                            <!-- Actions -->
                                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                                <Button Command="{Binding DataContext.OpenItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        Style="{StaticResource MaterialDesignIconButton}"
                                                                        Width="32" Height="32" Padding="4"
                                                                        ToolTip="Abrir">
                                                                    <materialDesign:PackIcon Kind="OpenInApp" Width="18" Height="18"/>
                                                                </Button>
                                                                <Button Command="{Binding DataContext.RemoveItemFromCollectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        Style="{StaticResource MaterialDesignIconButton}"
                                                                        Width="32" Height="32" Padding="4"
                                                                        ToolTip="Quitar"
                                                                        Foreground="{DynamicResource ValidationErrorBrush}">
                                                                    <materialDesign:PackIcon Kind="Delete" Width="18" Height="18"/>
                                                                </Button>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Grid>
                                                </materialDesign:Card>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <!-- Empty State -->
                                <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Visibility="{Binding FilteredItems.Count, Converter={StaticResource BoolToVis}}">
                                    <materialDesign:PackIcon Kind="BookOpenBlankVariant" Width="80" Height="80" 
                                                             Opacity="0.3"/>
                                    <TextBlock Text="No hay cómics en esta colección" FontSize="18" 
                                               Opacity="0.5" Margin="0,16,0,0" TextAlignment="Center"/>
                                    <TextBlock Text="Agrega algunos cómics para comenzar" FontSize="14" 
                                               Opacity="0.4" Margin="0,8,0,0" TextAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </materialDesign:Card>

                        <!-- Panel Derecho: Detalles y Estadísticas -->
                        <materialDesign:Card Grid.Column="2" Margin="8,0,0,0" UniformCornerRadius="12">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="20">
                                    <TextBlock Text="📊 Estadísticas" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>

                                    <!-- Stats Cards -->
                                    <materialDesign:Card Margin="0,0,0,12" Padding="16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon Kind="BookMultiple" Width="40" Height="40" 
                                                                     Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                                <TextBlock Text="{Binding Statistics.TotalItems}" FontSize="24" FontWeight="Bold"/>
                                                <TextBlock Text="Total de Cómics" Opacity="0.6"/>
                                            </StackPanel>
                                        </Grid>
                                    </materialDesign:Card>

                                    <materialDesign:Card Margin="0,0,0,12" Padding="16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon Kind="CheckCircle" Width="40" Height="40" 
                                                                     Foreground="{DynamicResource SecondaryHueMidBrush}"/>
                                            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                                <TextBlock Text="{Binding Statistics.CompletedItems}" FontSize="24" FontWeight="Bold"/>
                                                <TextBlock Text="Completados" Opacity="0.6"/>
                                            </StackPanel>
                                        </Grid>
                                    </materialDesign:Card>

                                    <materialDesign:Card Margin="0,0,0,12" Padding="16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon Kind="Star" Width="40" Height="40" 
                                                                     Foreground="#FFC107"/>
                                            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                                <TextBlock Text="{Binding Statistics.AverageRating, StringFormat='{}{0:F1}'}" 
                                                           FontSize="24" FontWeight="Bold"/>
                                                <TextBlock Text="Rating Promedio" Opacity="0.6"/>
                                            </StackPanel>
                                        </Grid>
                                    </materialDesign:Card>

                                    <materialDesign:Card Padding="16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon Kind="ClockOutline" Width="40" Height="40" 
                                                                     Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                                <TextBlock Text="{Binding Statistics.TotalReadingTime.TotalHours, StringFormat='{}{0:F0}h'}" 
                                                           FontSize="24" FontWeight="Bold"/>
                                                <TextBlock Text="Tiempo de Lectura" Opacity="0.6"/>
                                            </StackPanel>
                                        </Grid>
                                    </materialDesign:Card>

                                    <!-- Top Tags -->
                                    <TextBlock Text="🏷️ Etiquetas Populares" FontSize="16" FontWeight="Bold" 
                                               Margin="0,24,0,12"/>
                                    <ItemsControl ItemsSource="{Binding Statistics.TagDistribution}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource PrimaryHueLightBrush}"
                                                        CornerRadius="16" Padding="12,6" Margin="0,0,8,8"
                                                        HorizontalAlignment="Left">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Key}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Value, StringFormat=' ({0})'}" 
                                                                   Opacity="0.7" Margin="4,0,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </materialDesign:Card>
                    </Grid>

                    <!-- Status Bar -->
                    <Border Grid.Row="3" Background="{DynamicResource MaterialDesignDivider}" 
                            Padding="20,12" CornerRadius="0,0,12,12">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Information" VerticalAlignment="Center" 
                                                         Opacity="0.7" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <ProgressBar IsIndeterminate="True" Height="4" 
                                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                                         HorizontalAlignment="Right" Width="200"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </materialDesign:DialogHost>
</Window>
