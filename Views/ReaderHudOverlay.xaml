<UserControl x:Class="ComicReader.Views.ReaderHudOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000">
    <Grid>
        <!-- HUD SUPERIOR FLOTANTE -->
        <Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,20,0,0" Background="{StaticResource GlassBackground}" CornerRadius="14" Padding="16,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <Button Content="← Biblioteca" Style="{StaticResource WindowControlButton}" Width="90" Height="28" FontSize="11" Click="BackToLibrary_Click"/>
                <Border Width="1" Background="{StaticResource BorderBrush}" Margin="12,2"/>
                <TextBlock x:Name="ComicTitleText" Text="Batman: The Long Halloween #01" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <TextBlock x:Name="PageIndicatorText" Text="Pág. 14 / 36" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- HUD INFERIOR FLOTANTE -->
        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,24" Background="{StaticResource GlassBackground}" CornerRadius="14" Padding="20,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Width="600">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="◄ Anterior" Style="{StaticResource WindowControlButton}" Width="75" Height="28" FontSize="11" Click="PrevPage_Click"/>

                <Slider Grid.Column="1" x:Name="PageHudSlider" VerticalAlignment="Center" Margin="16,0" ValueChanged="PageHudSlider_ValueChanged"/>

                <Button Grid.Column="2" Content="Siguiente ►" Style="{StaticResource WindowControlButton}" Width="80" Height="28" FontSize="11" Click="NextPage_Click"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>