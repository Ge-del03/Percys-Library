<UserControl x:Class="ComicReader.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ComicReader.Views"
             x:Name="SettingsViewRoot"
             Height="400" Width="600">
    <!--
      Diseño "Comic Premium v2":
      - Se usan claves DynamicResource para que los Theme ResourceDictionaries las redefinan.
      - Estructura clara: header + panel de 2 columnas con Expanders para cada sección.
      - Componentes reutilizables (StatCard, SectionHeader).
      - Validación de entradas numéricas y animaciones sutiles.
      - Requiere definir recursos (brushes, fonts) en App.xaml o ResourceDictionaries de tema:
        ComicBackgroundBrush, ComicPaperBrush, ComicCardBackgroundBrush, ComicPanelBorderBrush,
        ComicAccentBrush, ComicAccentBrush2, ComicMutedTextBrush, ComicTextBrush, ComicNumberBrush,
        ComicButtonBrush, ComicButtonBorderBrush, ComicFontDisplay, ComicFontPrimary.
    -->

    <UserControl.Resources>
        <!-- Paleta alto contraste - estilo cómic -->
        <SolidColorBrush x:Key="ComicCardBackgroundBrush">#FF0F1720</SolidColorBrush>
        <SolidColorBrush x:Key="ComicPanelBorderBrush">#FFFFE082</SolidColorBrush>
        <SolidColorBrush x:Key="ComicButtonBrush">#FF1F2937</SolidColorBrush>
        <SolidColorBrush x:Key="ComicButtonBorderBrush">#FFFFC107</SolidColorBrush>
        <SolidColorBrush x:Key="ComicTextBrush">#FFF7F7F7</SolidColorBrush>
        <SolidColorBrush x:Key="ComicBackgroundBrush">#FF071018</SolidColorBrush>
        <SolidColorBrush x:Key="ComicAccentBrush">#FFE63946</SolidColorBrush>
        <SolidColorBrush x:Key="ComicAccentBrush2">#FF2ECC71</SolidColorBrush>
        <SolidColorBrush x:Key="ComicMutedTextBrush">#FFBDBDBD</SolidColorBrush>
        <SolidColorBrush x:Key="ComicPaperBrush">#FF0B1220</SolidColorBrush>
        <SolidColorBrush x:Key="ComicNumberBrush">#FFFFEE99</SolidColorBrush>
        <FontFamily x:Key="ComicFontDisplay">Segoe UI</FontFamily>
        <FontFamily x:Key="ComicFontPrimary">Segoe UI</FontFamily>

        <local:HexToBrushConverter x:Key="HexToBrushConverter"/>

        <!-- Estilos reutilizables -->
        <Style x:Key="ComicCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Background" Value="{DynamicResource ComicCardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ComicPanelBorderBrush}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="SectionHeader" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="ComicButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="{DynamicResource ComicFontDisplay}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Background" Value="{DynamicResource ComicButtonBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ComicButtonBorderBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Foreground" Value="{DynamicResource ComicTextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.95"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tarjeta estadística -->
        <DataTemplate x:Key="StatCardTemplate">
            <Border CornerRadius="8" BorderBrush="{DynamicResource ComicPanelBorderBrush}" BorderThickness="2" Background="{Binding BackgroundBrush, FallbackValue={DynamicResource ComicAccentBrush}}" Padding="10" Width="260" Height="120" Margin="6">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontFamily="{DynamicResource ComicFontPrimary}" Foreground="{Binding TitleBrush, FallbackValue={DynamicResource ComicTextBrush}}" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Value}" FontSize="22" FontFamily="{DynamicResource ComicFontDisplay}" Foreground="{Binding ValueBrush, FallbackValue={DynamicResource ComicNumberBrush}}" FontWeight="Bold" Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{DynamicResource ComicMutedTextBrush}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Animación discreta para aplicar tema -->
        <Storyboard x:Key="ApplyThemeAnim">
            <!-- Subtle opacity pulse instead of scaling to avoid animatability/path issues in templates -->
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.95" To="1" Duration="0:0:0.12" AutoReverse="True"/>
        </Storyboard>
    </UserControl.Resources>

    <Grid Background="{StaticResource ComicBackgroundBrush}">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Ben-Day overlay -->
        <Rectangle Fill="{StaticResource BenDayTile}" Opacity="0.06" IsHitTestVisible="False"/>

        <!-- Navigation column -->
        <Border Grid.Column="0" Background="{StaticResource ComicBackgroundBrush}" Padding="12">
            <StackPanel>
                <TextBlock Text="CONFIGURACIÓN" FontFamily="{StaticResource ComicDisplayFont}" Foreground="{StaticResource ComicPanelBrush}" FontSize="18" Margin="6"/>

                <StackPanel Orientation="Vertical" VerticalAlignment="Top">
                    <Button Style="{StaticResource NavigationBadgeButton}" Command="{Binding ChangeTabCommand}" CommandParameter="General"
                            ToolTip="General: ajustes principales" AutomationProperties.Name="Navegación General" AutomationProperties.HelpText="Ver y editar ajustes generales como idioma y preferencias básicas">
                        <StackPanel>
                            <Image Source="{StaticResource FistThumbDrawing}" Width="28" Height="28"/>
                            <TextBlock Text="GENERAL" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavigationBadgeButton}" Margin="0,12,0,0" Command="{Binding ChangeTabCommand}" CommandParameter="Apariencia"
                            ToolTip="Apariencia: tema y visual" AutomationProperties.Name="Navegación Apariencia" AutomationProperties.HelpText="Abrir ajustes de apariencia para cambiar tema y acentos">
                        <StackPanel>
                            <Ellipse Width="28" Height="28" Fill="#BDBDBD"/>
                            <TextBlock Text="APARIENCIA" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavigationBadgeButton}" Margin="0,12,0,0" Command="{Binding ChangeTabCommand}" CommandParameter="Lectura"
                            ToolTip="Lectura: ajustes de visualización de lectura" AutomationProperties.Name="Navegación Lectura" AutomationProperties.HelpText="Abrir ajustes relacionados con la experiencia de lectura (dirección, zoom, etc.)">
                        <StackPanel>
                            <Ellipse Width="28" Height="28" Fill="#BDBDBD"/>
                            <TextBlock Text="LECTURA" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavigationBadgeButton}" Margin="0,12,0,0" Command="{Binding ChangeTabCommand}" CommandParameter="Avanzado"
                            ToolTip="Avanzado: opciones avanzadas para usuarios expertos" AutomationProperties.Name="Navegación Avanzado" AutomationProperties.HelpText="Abrir ajustes avanzados como cache, rendimiento y opciones experimentales">
                        <StackPanel>
                            <Ellipse Width="28" Height="28" Fill="#BDBDBD"/>
                            <TextBlock Text="AVANZADO" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Main content -->
        <Border Grid.Column="1" Style="{StaticResource ComicPanelStyle}" Margin="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Section title (dialog bubble style) -->
                <Border Background="{StaticResource ComicAccentYellowBrush}" CornerRadius="4" Padding="8" HorizontalAlignment="Left" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="AJUSTES DEL SISTEMA" FontFamily="{StaticResource ComicDisplayFont}" FontWeight="Bold" Foreground="{StaticResource ComicInkBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Content area -->
                <ScrollViewer Grid.Row="1">
                    <StackPanel>
                        <Border Style="{StaticResource ComicCardStyle}">
                            <StackPanel>
                                <StackPanel Style="{StaticResource SectionHeader}">
                                    <TextBlock Text="Idioma:" FontFamily="{StaticResource ComicPrimaryFont}" Foreground="{StaticResource ComicInkBrush}" VerticalAlignment="Center"/>
                                    <ComboBox Width="160" Margin="12,0,0,0" ToolTip="Selecciona el idioma de la interfaz" AutomationProperties.Name="Selector de idioma" AutomationProperties.HelpText="Cambia el idioma de la aplicación">
                                        <ComboBoxItem Content="Español" IsSelected="True"/>
                                        <ComboBoxItem Content="English"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Style="{StaticResource SectionHeader}">
                                    <TextBlock Text="Volumen de efectos" FontFamily="{StaticResource ComicPrimaryFont}" Foreground="{StaticResource ComicInkBrush}" VerticalAlignment="Center"/>
                                    <Slider Width="220" Minimum="0" Maximum="100" Value="60" Margin="12,0,0,0" ToolTip="Ajusta el volumen de los efectos de sonido" AutomationProperties.Name="Volumen de efectos" AutomationProperties.HelpText="Controla el volumen de efectos dentro de la aplicación"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Monitor de pruebas -->
                        <Border BorderBrush="{StaticResource ComicPanelBorderBrush}" BorderThickness="2" CornerRadius="6" Padding="12" Margin="10">
                            <StackPanel>
                                <TextBlock Text="MONITOR DE PRUEBAS" FontFamily="{StaticResource ComicPrimaryFont}" FontWeight="Bold"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Border Background="#FFF5F5" BorderBrush="#000" BorderThickness="1" Width="200" Height="90" AutomationProperties.Name="Vista de previsualización" AutomationProperties.HelpText="Área de previsualización para cambios de tema"/>
                                    <Button Style="{StaticResource ExplosionActionButton}" Margin="12,0,0,0" ToolTip="Ejecuta la acción de prueba" AutomationProperties.Name="Botón de acción de prueba" AutomationProperties.HelpText="Ejecuta una acción de ejemplo usada para verificar la UI">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{StaticResource PowHighDrawing}" Width="24" Height="24"/>
                                            <TextBlock Text="¡ACCION!" Margin="8,0,0,0" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Action buttons -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Style="{StaticResource ExplosionActionButton}" Background="{StaticResource ComicAccentGreenBrush}" Margin="6" AutomationProperties.Name="Aplicar cambios" ToolTip="Aplicar los cambios de configuración">¡APLICAR!</Button>
                    <Button Style="{StaticResource ExplosionActionButton}" Background="{StaticResource ComicAccentBlueBrush}" Margin="6" AutomationProperties.Name="Guardar configuración" ToolTip="Guardar la configuración actual">¡GUARDAR!</Button>
                    <Button Style="{StaticResource ExplosionActionButton}" Background="{StaticResource ComicAccentYellowBrush}" Margin="6" AutomationProperties.Name="Cancelar cambios" ToolTip="Cancelar y cerrar sin guardar">¡CANCELAR!</Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>