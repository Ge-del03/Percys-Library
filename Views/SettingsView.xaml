<UserControl x:Class="ComicReader.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:ComicReader.Converters"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <Grid>
        <Grid.Resources>
            <conv:SelectedSectionToVisibilityConverter x:Key="SelectedToVisibility" />
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left: sections + search -->
        <StackPanel Grid.Column="0" Margin="8">
            <TextBox x:Name="SearchBox" Margin="0,0,0,8" TextChanged="SearchBox_TextChanged" />
            <ListBox ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection, Mode=TwoWay}" Height="400" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="Guardar" Command="{Binding SaveCommand}" Width="90" Margin="4,0" />
                <Button Content="Aplicar" Command="{Binding ApplyCommand}" Width="90" Margin="4,0" />
            </StackPanel>
        </StackPanel>

        <!-- Right: content for selected section -->
        <Border Grid.Column="1" Margin="8" Padding="12" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
            <ScrollViewer>
                <StackPanel>
                    <TextBlock Text="Sección: " FontWeight="Bold" />
                    <TextBlock Text="{Binding SelectedSection}" Margin="0,0,0,12" />

                    <!-- General -->
                    <StackPanel Visibility="{Binding SelectedSection, Converter={StaticResource SelectedToVisibility}, ConverterParameter=General}">
                        <TextBlock Text="Tema" />
                        <ComboBox ItemsSource="{Binding AvailableThemes}" SelectedValue="{Binding AppSettings.Theme, Mode=TwoWay}"/>
                        <CheckBox Content="Mostrar miniaturas" IsChecked="{Binding AppSettings.ThumbnailsVisible, Mode=TwoWay}" />
                        <CheckBox Content="Modo nocturno" IsChecked="{Binding AppSettings.IsNightMode, Mode=TwoWay}" />
                    </StackPanel>

                    <!-- Apariencia -->
                    <StackPanel Visibility="{Binding SelectedSection, Converter={StaticResource SelectedToVisibility}, ConverterParameter=Apariencia}">
                        <TextBlock Text="Brillo" />
                        <Slider Minimum="0.5" Maximum="1.5" Value="{Binding AppSettings.Brightness, Mode=TwoWay}" />
                        <TextBlock Text="Contraste" Margin="0,8,0,0" />
                        <Slider Minimum="0.5" Maximum="1.5" Value="{Binding AppSettings.Contrast, Mode=TwoWay}" />
                        <Button Content="Restablecer apariencia avanzada" Command="{Binding ResetAdvancedAppearanceCommand}" Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- Lectura -->
                    <StackPanel Visibility="{Binding SelectedSection, Converter={StaticResource SelectedToVisibility}, ConverterParameter=Lectura}">
                        <CheckBox Content="Desplazamiento continuo" IsChecked="{Binding AppSettings.EnableContinuousScroll, Mode=TwoWay}" />
                        <TextBlock Text="Paso de scroll (ratio)" Margin="0,8,0,0" />
                        <Slider Minimum="0.1" Maximum="1.0" Value="{Binding AppSettings.PageScrollStepRatio, Mode=TwoWay}" />
                    </StackPanel>

                    <!-- Controles -->
                    <StackPanel Visibility="{Binding SelectedSection, Converter={StaticResource SelectedToVisibility}, ConverterParameter=Controles}">
                        <CheckBox Content="Usar espacio para siguiente página" IsChecked="{Binding AppSettings.SpacebarNextPage, Mode=TwoWay}" />
                    </StackPanel>

                    <!-- Rendimiento -->
                    <StackPanel Visibility="{Binding SelectedSection, Converter={StaticResource SelectedToVisibility}, ConverterParameter=Rendimiento}">
                        <TextBlock Text="Prefetch window" />
                        <TextBox Text="{Binding AppSettings.PrefetchWindow, Mode=TwoWay}" Width="80" />
                        <Button Content="Optimizar caché" Command="{Binding OptimizeCommand}" Margin="0,8,0,0" />
                    </StackPanel>

                    <!-- Personalizacion -->
                    <StackPanel Visibility="{Binding SelectedSection, Converter={StaticResource SelectedToVisibility}, ConverterParameter=Personalizacion}">
                        <TextBlock Text="Carpeta por defecto" />
                        <StackPanel Orientation="Horizontal">
                            <TextBox Text="{Binding AppSettings.DefaultComicsFolder, Mode=TwoWay}" Width="300" />
                            <Button Content="Cambiar" Command="{Binding ChangeFolderCommand}" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Acerca -->
                    <StackPanel Visibility="{Binding SelectedSection, Converter={StaticResource SelectedToVisibility}, ConverterParameter=Acerca}">
                        <TextBlock Text="Percy's Library" FontSize="16" FontWeight="Bold" />
                        <TextBlock Text="Versión: 1.0 (stub)" />
                        <Button Content="Ver créditos" Command="{Binding ViewCreditsCommand}" Margin="0,8,0,0" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
