<Window x:Class="ComicReader.Views.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Topmost="True"
        Width="320" Height="64" ResizeMode="NoResize" Opacity="0">
    <Border Background="#DD111827" CornerRadius="8" Padding="12" Margin="8" Opacity="0.95">
        <TextBlock x:Name="MessageText" Foreground="White" TextWrapping="Wrap" FontSize="13" />
    </Border>
</Window>
