<UserControl x:Class="ComicReader.Views.Controls.PreviewPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="200" Width="300">

  <!-- Default local resources used as fallbacks if theme resources are not present -->
  <UserControl.Resources>
    <SolidColorBrush x:Key="PreviewBg" Color="#FFFDF7EC" />
    <SolidColorBrush x:Key="PreviewCardBg" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="PreviewAccentBrush" Color="#FFED6A00" />
    <SolidColorBrush x:Key="PreviewTextBrush" Color="#FF1B1B1B" />
    <SolidColorBrush x:Key="PreviewButtonTextBrush" Color="#FFFFFFFF" />
  </UserControl.Resources>

  <Border Background="{DynamicResource PreviewBg}" CornerRadius="12" Padding="8">
    <Grid>
      <StackPanel>
        <TextBlock Text="Vista Previa" Foreground="{DynamicResource PreviewTextBrush}" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" />
  <Border Background="{DynamicResource PreviewCardBg}" CornerRadius="6" Margin="12,8,12,8" Padding="8">
          <StackPanel>
            <TextBlock Text="Título de ejemplo" Foreground="{DynamicResource PreviewTextBrush}" FontWeight="Bold" />
            <TextBlock Text="Este es un párrafo de ejemplo para mostrar la tipografía y el color del tema." TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource PreviewTextBrush}" />
            <Button Content="Acción" Width="100" Margin="0,8,0,0" Background="{DynamicResource PreviewAccentBrush}" Foreground="{DynamicResource PreviewButtonTextBrush}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
