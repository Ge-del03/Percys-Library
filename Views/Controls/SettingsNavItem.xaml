<UserControl x:Class="ComicReader.Views.Controls.SettingsNavItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="48" Width="Auto">
  <Grid>
    <Border Background="Transparent" Padding="8">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Ellipse Width="28" Height="28" Fill="{StaticResource Accent2Brush}" Margin="4" />
        <TextBlock Text="NavItem" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
