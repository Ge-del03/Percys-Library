<UserControl x:Class="ComicReader.Views.Controls.SettingsCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="Auto" Width="Auto">
  <Border Style="{StaticResource SettingsCard}">
    <StackPanel>
      <TextBlock Text="Card Title" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
      <TextBlock Text="Card body..." Foreground="{StaticResource TextMutedBrush}" FontSize="13" />
    </StackPanel>
  </Border>
</UserControl>
