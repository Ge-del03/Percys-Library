<UserControl x:Class="ComicReader.Views.Controls.CollectionCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ComicReader.Views.Controls"
             Height="160" Width="260">
    <Border Background="{StaticResource CS_CardBackground}" CornerRadius="10" Padding="12" Margin="8" SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource CS_TextPrimary}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Width="28" Height="28" Margin="4,0,0,0" Content="✎" ToolTip="Editar" Command="{Binding DataContext.RenameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                    <Button Width="28" Height="28" Margin="4,0,0,0" Content="🗑" ToolTip="Eliminar" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                </StackPanel>
            </Grid>

            <ItemsControl Grid.Row="1" ItemsSource="{Binding Items}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#EEE" Margin="4" Width="56" Height="72">
                            <Image Source="{Binding ThumbPath}" Stretch="UniformToFill" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Grid.Row="2" Text="{Binding Count, StringFormat='{}{0} cómics'}" Foreground="{StaticResource CS_TextSecondary}" FontSize="12" HorizontalAlignment="Left" />
        </Grid>
    </Border>
</UserControl>
