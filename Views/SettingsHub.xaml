<UserControl x:Class="ComicReader.Views.SettingsHub"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ComicReader.ViewModels"
             xmlns:local="clr-namespace:ComicReader.Views"
             xmlns:sections="clr-namespace:ComicReader.Views.Sections"
             xmlns:conv="clr-namespace:ComicReader.Converters"
             xmlns:views="clr-namespace:ComicReader.Views.Controls"
             Height="Auto" Width="Auto">
    <Grid x:Name="HubRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,0,12">
            <TextBlock Text="Percy's Library" FontSize="18" FontWeight="Bold" Foreground="#3b2e2e" />
            <TextBlock Text=" — Opciones" Margin="12,0,0,0" Foreground="#7d6b6b" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,0,0,0">
                <TextBox x:Name="QuickFindBox" Width="260" Height="26" VerticalAlignment="Center" ToolTip="Buscar opciones..." TextChanged="QuickFindBox_TextChanged" />
                <Button Content="X" Width="26" Height="26" Margin="8,0,0,0" Click="QuickFindClear_Click" />
            </StackPanel>
        </StackPanel>

        <!-- DEBUG BANNER: visible temporalmente para confirmar renderizado -->
        <Border Grid.Row="0" Background="#FFFF77" CornerRadius="10" Padding="8" Margin="0,44,0,8" HorizontalAlignment="Stretch">
            <TextBlock Text="DEBUG: El contenido de Settings se está renderizando (banner de prueba)." Foreground="#111" FontWeight="Bold" HorizontalAlignment="Center" />
        </Border>

        <ScrollViewer x:Name="HubScroll" Grid.Row="1">
            <ScrollViewer.Resources>
                <conv:SelectedSectionToVisibilityConverter x:Key="SectionVis" />
            </ScrollViewer.Resources>
            <StackPanel x:Name="HubStack">
                <sections:GeneralSection Visibility="{Binding SelectedSection, Converter={StaticResource SectionVis}, ConverterParameter=General}" />

                <sections:AppearanceSection Visibility="{Binding SelectedSection, Converter={StaticResource SectionVis}, ConverterParameter=Apariencia}" />
                <views:PreviewPanel x:Name="LivePreview" Width="320" Height="180" Margin="0,12,0,0" PreviewTheme="{Binding DataContext.PreviewTheme, ElementName=HubRoot, Mode=TwoWay}" />

                <sections:ReadingSection Visibility="{Binding SelectedSection, Converter={StaticResource SectionVis}, ConverterParameter=Lectura}" />
                <sections:AdvancedSection Visibility="{Binding SelectedSection, Converter={StaticResource SectionVis}, ConverterParameter=Avanzado}" />
                <Border Margin="0,12,0,0">
                    <!-- spacer for separation between cards when Spacing not available -->
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
