<Window x:Class="ComicReader.Views.StatisticsWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:controls="clr-namespace:ComicReader.Views.Controls"
		xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
		Title="Estadísticas de Lectura" Height="720" Width="1200"
		WindowStartupLocation="CenterOwner"
		Background="{StaticResource RS_AppBackgroundBrush}">

	<Window.Resources>
		<BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
	</Window.Resources>

	<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
		<StackPanel Orientation="Vertical" Margin="0,16,0,32">
			<!-- Hero section -->
			<Border Background="{StaticResource RS_HeroGradientBrush}" CornerRadius="28" Padding="32" Margin="28,0,28,24">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="320"/>
					</Grid.ColumnDefinitions>

					<StackPanel>
						<TextBlock Text="Tu universo de lectura" FontSize="34" FontWeight="Bold" Foreground="{StaticResource RS_TextOnDarkBrush}"/>
						<TextBlock Text="Domina tus hábitos con visualizaciones pensadas para amantes de las viñetas." FontSize="15" Foreground="{StaticResource RS_TextMutedBrush}" Margin="0,8,0,24" TextWrapping="Wrap"/>
						<ItemsControl ItemsSource="{Binding HeroHighlights}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<UniformGrid Columns="3"/>
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Border Margin="6" Padding="18" Background="#2A3246" CornerRadius="18" BorderBrush="#3340566A" BorderThickness="1">
										<StackPanel>
											<TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons" FontSize="24" Foreground="{Binding AccentShadowBrush}" Opacity="0.85"/>
											<TextBlock Text="{Binding Title}" Foreground="{StaticResource RS_TextOnDarkBrush}" FontWeight="SemiBold" Margin="0,10,0,0"/>
											<TextBlock Text="{Binding Value}" Foreground="{StaticResource RS_TextOnDarkBrush}" FontSize="22" FontWeight="Bold"/>
											<TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource RS_TextMutedBrush}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
										</StackPanel>
									</Border>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</StackPanel>

					<Border Grid.Column="1" CornerRadius="20" Background="#1F2D41" Padding="24" Margin="24,0,0,0">
						<StackPanel>
							<TextBlock Text="Favoritos" Foreground="{StaticResource RS_TextOnDarkBrush}" FontWeight="SemiBold" FontSize="18"/>
							<TextBlock Text="{Binding FavoriteGenre, StringFormat=Género favorito: {0}}" Foreground="{StaticResource RS_TextMutedBrush}" FontSize="13" Margin="0,16,0,0"/>
							<TextBlock Text="{Binding FavoriteDay, StringFormat=Día preferido: {0}}" Foreground="{StaticResource RS_TextMutedBrush}" FontSize="13" Margin="0,6,0,0"/>
							<TextBlock Text="{Binding PreferredFormat, StringFormat=Formato favorito: {0}}" Foreground="{StaticResource RS_TextMutedBrush}" FontSize="13" Margin="0,6,0,0"/>
						</StackPanel>
					</Border>
				</Grid>
			</Border>

			<Grid Margin="28,0,28,0">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="2.2*"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>

				<!-- Analytical column -->
				<StackPanel Grid.Column="0">
					<Border Style="{StaticResource RS_ElevatedCardStyle}">
						<StackPanel>
							<TextBlock Text="Resumen cinemático" Foreground="{StaticResource RS_TextOnDarkBrush}" FontSize="18" FontWeight="SemiBold"/>
							<ItemsControl ItemsSource="{Binding Stats}" Margin="0,20,0,0">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<UniformGrid Columns="4"/>
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Border Margin="8" Padding="16" Background="#1F2D41" CornerRadius="16" BorderBrush="#314057" BorderThickness="1">
											<StackPanel>
												<TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons" FontSize="20" Foreground="{Binding AccentBrush}" Opacity="0.85"/>
												<TextBlock Text="{Binding Label}" Foreground="{StaticResource RS_TextMutedBrush}" FontSize="12" Margin="0,6,0,0"/>
												<TextBlock Text="{Binding Value}" Foreground="{StaticResource RS_TextOnDarkBrush}" FontSize="{StaticResource RS_StatValueSize}" FontWeight="Bold"/>
												<TextBlock Text="{Binding Caption}" Foreground="{StaticResource RS_TextMutedBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
												<StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding HasTrend, Converter={StaticResource BoolToVisibility}}">
													<TextBlock Text="{Binding TrendDeltaText}" Foreground="{Binding AccentBrush}" FontSize="11" FontWeight="SemiBold"/>
													<TextBlock Text="{Binding TrendLabel}" Foreground="{StaticResource RS_TextMutedBrush}" FontSize="11" Margin="8,0,0,0"/>
												</StackPanel>
											</StackPanel>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</StackPanel>
					</Border>

					<Grid Margin="0,28,0,0">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>
						<Border Style="{StaticResource RS_ElevatedCardStyle}">
							<StackPanel>
								<TextBlock Text="Actividad diaria" Foreground="{StaticResource RS_TextOnDarkBrush}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12"/>
								<lvc:CartesianChart Series="{Binding DailyActivitySeries}" Background="Transparent" Height="260"/>
							</StackPanel>
						</Border>
						<Border Grid.Column="1" Style="{StaticResource RS_ElevatedCardStyle}" Margin="20,0,0,0">
							<StackPanel>
								<TextBlock Text="Ritmo semanal" Foreground="{StaticResource RS_TextOnDarkBrush}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12"/>
								<lvc:CartesianChart Series="{Binding DayOfWeekSeries}" Background="Transparent" Height="260"/>
							</StackPanel>
						</Border>
					</Grid>

					<Grid Margin="0,28,0,0">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="1.2*"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>
						<Border Style="{StaticResource RS_ElevatedCardStyle}">
							<StackPanel>
								<TextBlock Text="Universo de géneros" Foreground="{StaticResource RS_TextOnDarkBrush}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12"/>
								<lvc:PieChart Series="{Binding GenreShareSeries}" Height="260" Background="Transparent"/>
							</StackPanel>
						</Border>
						<Border Grid.Column="1" Style="{StaticResource RS_ElevatedCardStyle}" Margin="20,0,0,0">
							<StackPanel>
								<TextBlock Text="Top finalizaciones" Foreground="{StaticResource RS_TextOnDarkBrush}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12"/>
								<ItemsControl ItemsSource="{Binding CompletionLeaders}">
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<Border Margin="0,0,0,16" Padding="0,0,0,6" BorderBrush="#253345" BorderThickness="0,0,0,1">
												<Grid>
													<Grid.RowDefinitions>
														<RowDefinition Height="Auto"/>
														<RowDefinition Height="Auto"/>
														<RowDefinition Height="Auto"/>
													</Grid.RowDefinitions>
													<Grid.ColumnDefinitions>
														<ColumnDefinition Width="*"/>
														<ColumnDefinition Width="Auto"/>
													</Grid.ColumnDefinitions>
													<TextBlock Text="{Binding Title}" Foreground="{StaticResource RS_TextOnDarkBrush}" FontWeight="SemiBold" Grid.Column="0"/>
													<TextBlock Text="{Binding CompletionText}" Foreground="{StaticResource RS_TextMutedBrush}" Grid.Column="1" Margin="16,0,0,0"/>
													<ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource RS_ProgressBarStyle}" Value="{Binding Completion}" Maximum="100" Margin="0,8,0,0"/>
													<TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding PagesText}" Foreground="{StaticResource RS_TextMutedBrush}" FontSize="11" Margin="0,6,0,0"/>
													<TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LastReadText}" Foreground="{StaticResource RS_TextMutedBrush}" FontSize="11" Margin="16,6,0,0"/>
												</Grid>
											</Border>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>
						</Border>
					</Grid>
				</StackPanel>

				<!-- Activity column -->
				<StackPanel Grid.Column="1" Margin="24,0,0,0">
					<Border Style="{StaticResource RS_ElevatedCardStyle}">
						<StackPanel>
							<TextBlock Text="Progreso en curso" Foreground="{StaticResource RS_TextOnDarkBrush}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12"/>
							<ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="360">
								<ItemsControl ItemsSource="{Binding ProgressList}">
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<controls:ProgressComicItem Title="{Binding Title}" Percentage="{Binding Percentage}" PagesText="{Binding PagesText}" ThumbnailPath="{Binding ThumbnailPath}" AccessibilityHelp="{Binding AccessibilityHelp}" Margin="0,0,0,12"/>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</ScrollViewer>
						</StackPanel>
					</Border>

					<Border Style="{StaticResource RS_ElevatedCardStyle}" Margin="0,24,0,0">
						<StackPanel>
							<TextBlock Text="Sesiones de hoy" Foreground="{StaticResource RS_TextOnDarkBrush}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12"/>
							<ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="280">
								<ItemsControl ItemsSource="{Binding TodaySessions}">
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<Border Padding="10" Margin="0,0,0,10" CornerRadius="12" Background="#1B2738" Focusable="True"
													AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding HelpText}"
													MouseLeftButtonDown="SessionItem_MouseLeftButtonDown" KeyDown="SessionItem_KeyDown">
												<Grid>
													<Grid.ColumnDefinitions>
														<ColumnDefinition Width="60"/>
														<ColumnDefinition Width="*"/>
														<ColumnDefinition Width="Auto"/>
													</Grid.ColumnDefinitions>
													<TextBlock Text="{Binding StartText}" Foreground="{StaticResource RS_TextMutedBrush}" FontSize="12" VerticalAlignment="Top"/>
													<StackPanel Grid.Column="1" Margin="10,0,0,0">
														<TextBlock Text="{Binding Title}" Foreground="{StaticResource RS_TextOnDarkBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
														<TextBlock Text="{Binding PagesText}" Foreground="{StaticResource RS_TextMutedBrush}" FontSize="11"/>
													</StackPanel>
													<TextBlock Grid.Column="2" Text="{Binding DurationText}" Foreground="{StaticResource RS_TextMutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="16,0,0,0"/>
												</Grid>
											</Border>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</ScrollViewer>
						</StackPanel>
					</Border>

					<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,28,0,0">
						<Button Content="Exportar" Background="{StaticResource RS_SuccessBrush}" Foreground="White" Padding="14,6" Margin="6" Click="ExportButton_Click"/>
						<Button Content="Resetear" Background="{StaticResource RS_DangerBrush}" Foreground="White" Padding="14,6" Margin="6" Click="ResetButton_Click"/>
						<Button Content="Cerrar" Background="#3350647C" Foreground="White" Padding="14,6" Margin="6" Click="CloseButton_Click"/>
					</StackPanel>
				</StackPanel>
			</Grid>
		</StackPanel>
	</ScrollViewer>
</Window>

