<UserControl x:Class="ComicReader.Views.Prototypes.HomeViewPrototype"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="600" Width="980">
  <Grid Background="{StaticResource ComicPanelBrush}">
    <StackPanel Margin="18">
      <Border Background="#FFF5D6" CornerRadius="8" Padding="12" BorderBrush="{StaticResource ComicInkBrush}" BorderThickness="3">
        <TextBlock Text="Último lectura" FontFamily="{StaticResource ComicDisplayFont}" FontSize="20"/>
      </Border>

      <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
        <Border Width="300" Height="180" Background="#FFF5F5" BorderBrush="{StaticResource ComicInkBrush}" BorderThickness="2" CornerRadius="6" Margin="6"/>
        <Border Width="300" Height="180" Background="#FFF5F5" BorderBrush="{StaticResource ComicInkBrush}" BorderThickness="2" CornerRadius="6" Margin="6"/>
        <Border Width="300" Height="180" Background="#FFF5F5" BorderBrush="{StaticResource ComicInkBrush}" BorderThickness="2" CornerRadius="6" Margin="6"/>
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>