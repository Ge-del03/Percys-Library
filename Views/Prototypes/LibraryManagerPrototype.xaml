<UserControl x:Class="ComicReader.Views.Prototypes.LibraryManagerPrototype"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="640" Width="980">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="240"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="300"/>
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="{StaticResource ComicPanelBrush}" Padding="12">
      <StackPanel>
        <TextBlock Text="Filtros" FontFamily="{StaticResource ComicDisplayFont}" FontSize="16"/>
        <TextBox Margin="0,8,0,0" />
        <TextBlock Text="Tamaño miniaturas" Margin="0,12,0,0"/>
        <Slider x:Name="ThumbSizeSlider" Minimum="80" Maximum="260" Value="140"/>
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Column="1">
      <UniformGrid Columns="3" x:Name="ThumbGrid" Margin="12">
        <!-- sample thumbnails -->
        <Border Width="140" Height="200" Background="#FFF5F5" BorderBrush="{StaticResource ComicInkBrush}" BorderThickness="2" Margin="6"/>
        <Border Width="140" Height="200" Background="#FFF5F5" BorderBrush="{StaticResource ComicInkBrush}" BorderThickness="2" Margin="6"/>
        <Border Width="140" Height="200" Background="#FFF5F5" BorderBrush="{StaticResource ComicInkBrush}" BorderThickness="2" Margin="6"/>
      </UniformGrid>
    </ScrollViewer>

    <Border Grid.Column="2" Background="{StaticResource ComicPanelBrush}" Padding="12" Margin="6">
      <TextBlock Text="Vista previa" FontFamily="{StaticResource ComicDisplayFont}" FontSize="16"/>
    </Border>
  </Grid>
</UserControl>