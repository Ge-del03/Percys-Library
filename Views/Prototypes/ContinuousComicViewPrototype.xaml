<UserControl x:Class="ComicReader.Views.Prototypes.ContinuousComicViewPrototype"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="640" Width="980">
  <Grid Background="{StaticResource ComicPanelBrush}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Padding="12" Background="{StaticResource ComicBackgroundBrush}">
      <TextBlock Text="Thumbnails" FontFamily="{StaticResource ComicDisplayFont}"/>
    </Border>

    <ScrollViewer Grid.Column="1">
      <StackPanel Margin="12">
        <Border Height="400" Background="#FFF5F5" BorderBrush="{StaticResource ComicInkBrush}" BorderThickness="3" CornerRadius="6" Margin="0,0,0,12"/>
        <Border Height="400" Background="#FFF5F5" BorderBrush="{StaticResource ComicInkBrush}" BorderThickness="3" CornerRadius="6"/>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>