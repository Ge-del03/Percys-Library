<UserControl x:Class="ComicReader.Views.Prototypes.ComicViewPrototype"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="640" Width="980">
  <Grid Background="{StaticResource ComicPanelBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Background="{StaticResource ComicAccentYellowBrush}" Height="48">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="8">
        <Button Style="{StaticResource ExplosionActionButton}" Margin="4">◀</Button>
        <Button Style="{StaticResource ExplosionActionButton}" Margin="4">▶</Button>
      </StackPanel>
      <TextBlock Text="Página 12 / 120" VerticalAlignment="Center" HorizontalAlignment="Center" FontFamily="{StaticResource ComicDisplayFont}"/>
    </DockPanel>

    <Border Grid.Row="1" Margin="12" Background="#FFF5F5" BorderBrush="{StaticResource ComicInkBrush}" BorderThickness="3" CornerRadius="6">
      <Grid>
        <TextBlock Text="Área de página (imagen)" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12">
          <Button Style="{StaticResource NavigationBadgeButton}">🔍</Button>
          <Button Style="{StaticResource NavigationBadgeButton}">↻</Button>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>