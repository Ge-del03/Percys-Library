<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
  <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>ComicReader</RootNamespace>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Evitar duplicados generados por WPF/wpftmp: no generar automáticamente el TargetFrameworkAttribute -->
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <!-- Mantener GenerateAssemblyInfo por compatibilidad si hay AssemblyInfo.cs manual -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ApplicationIcon>icono.ico</ApplicationIcon>
    <DefineConstants>$(DefineConstants);SUPPORT_PDF</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="MainWindow.ZoomCompat.g.cs" />
    <Compile Remove="Services/ComicPageLoader.cs" />
    <Compile Remove="Percy Library 2.0/ComicPageLoader.cs" />
    <Compile Remove="Percy Library 2.0/Services/ComicPageLoader.cs" />
    <Compile Remove="Percy Library 2.0/MainWindow.cs" />
    <Compile Remove="Percy Library 2.0/MainWindow.xaml" />
    <Compile Remove="Percy Library 2.0/MainWindow.ZoomCompat.g.cs" />
    <Compile Remove="Percy Library 2.0/Views/MainWindow.xaml.cs" />
    <!-- Excluir archivos de pruebas para que no se compilen con el proyecto principal -->
    <Compile Remove="tests\**\*.cs" />
  </ItemGroup>
  <!-- Prevent MSBuild from attempting to compile the obsolete-settings-backup folder by excluding it from the project. -->
  <ItemGroup>
    <None Remove="obsolete-settings-backup\**" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="obsolete-settings-backup\Views.SettingsView.xaml" />
    <None Remove="obsolete-settings-backup\Views.SettingsView.xaml.cs" />
    <None Remove="obsolete-settings-backup\Views.SettingsSidebar.xaml" />
    <None Remove="obsolete-settings-backup\Views.SettingsDialog.xaml" />
    <None Remove="obsolete-settings-backup\Views.SettingsDialog.xaml.cs" />
    <!-- Extra safety: remove any XAML files in that folder from being considered as Page/Compile/Resource -->
    <Page Remove="obsolete-settings-backup\**\*.xaml" />
    <Compile Remove="obsolete-settings-backup\**\*.cs" />
    <Resource Remove="obsolete-settings-backup\**\*.*" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="icono.ico" />
  </ItemGroup>
  
  <!-- Copiar el icono de portada de archivos al directorio de salida para usarlo como DefaultIcon y placeholder -->
  <ItemGroup>
    <Content Include="logo de archivo.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Themes\**\*.xaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Styles\**\*.xaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="design\tokens\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Settings\**\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  
  
  
  <ItemGroup>
    <!-- Dependencias actualizadas a versiones recientes y soportadas -->
    <PackageReference Include="SharpCompress" Version="0.33.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
    <PackageReference Include="VersOne.Epub" Version="3.3.4" />
    <PackageReference Include="System.Drawing.Common" Version="7.0.0" />
    <PackageReference Include="Docnet.Core" Version="2.6.0" />
  </ItemGroup>

  <!-- Evitar generar el .exe (apphost) en Debug para que no se bloquee por procesos externos -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>
</Project>

