<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Simple Ben-Day dot tile as DrawingBrush -->
  <!-- Use semi-transparent brush rather than Opacity on GeometryDrawing which can cause MC3072 in some XAML parsers -->
  <DrawingBrush x:Key="BenDayTile" TileMode="Tile" Viewport="0,0,24,24" ViewportUnits="Absolute" Stretch="None">
    <DrawingBrush.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="#0F000000">
          <GeometryDrawing.Geometry>
            <EllipseGeometry RadiusX="4" RadiusY="4" Center="12,12"/>
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingBrush.Drawing>
  </DrawingBrush>
</ResourceDictionary>