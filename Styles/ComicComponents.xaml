<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Component templates for the comic theme -->

  <!-- Settings navigation item: a badge-like button with active visual state -->
  <Style x:Key="SettingsNavItemStyle" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource ComicPrimaryFont}"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="{StaticResource ComicInkBrush}"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="Padding" Value="8"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="8">
              <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
            <!-- Active stroke -->
            <Border x:Name="ActiveStroke" BorderBrush="{StaticResource ComicAccentYellowBrush}" BorderThickness="3" CornerRadius="8" Opacity="0"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Opacity" Value="0.95"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.96" ScaleY="0.96"/></Setter.Value></Setter>
            </Trigger>
            <!-- Removed placeholder DataTrigger that referenced sys:String which was not declared in this ResourceDictionary -->
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Settings card: panel used for grouped options -->
  <Style x:Key="SettingsCardStyle" TargetType="Border" BasedOn="{StaticResource ComicPanelStyle}">
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="12"/>
    <Setter Property="Margin" Value="8"/>
  </Style>

  <!-- Toggle 3D arcade style -->
  <Style x:Key="ToggleComicStyle" TargetType="ToggleButton">
    <Setter Property="Width" Value="64"/>
    <Setter Property="Height" Value="34"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid>
            <Border x:Name="Track" Background="#BDBDBD" CornerRadius="18" BorderBrush="{StaticResource ComicInkBrush}" BorderThickness="2"/>
            <Ellipse x:Name="Thumb" Width="28" Height="28" Fill="#FFF" Stroke="{StaticResource ComicInkBrush}" StrokeThickness="2" Margin="3" HorizontalAlignment="Left"/>
            <TextBlock x:Name="Zap" Text="ZAP" FontFamily="{StaticResource ComicDisplayFont}" Foreground="{StaticResource ComicAccentYellowBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="6" Opacity="0"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{StaticResource ComicAccentGreenBrush}"/>
              <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
              <Setter TargetName="Zap" Property="Opacity" Value="1"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Track" Property="Opacity" Value="0.95"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Slider thumb as DrawingImage (uses resource FistThumbDrawing if present) -->
  <Style x:Key="SliderComicStyle" TargetType="Slider">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid>
            <Track x:Name="PART_Track" VerticalAlignment="Center">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageLeftCommand" Background="Transparent"/>
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Width="28" Height="28" Name="Thumb">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Grid>
                        <Image Source="{StaticResource FistThumbDrawing}" Width="28" Height="28"/>
                      </Grid>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageRightCommand" Background="Transparent"/>
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>