<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Control templates: Slider thumb as fist, Toggle, and ComicPanel helpers -->
  <Style x:Key="ComicSlider" TargetType="Slider">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid>
            <Track x:Name="PART_Track" VerticalAlignment="Center">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageLeftCommand" Background="Transparent"/>
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Width="28" Height="28" Name="Thumb">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Grid>
                        <Image Source="{StaticResource FistThumbDrawing}" Width="28" Height="28"/>
                      </Grid>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageRightCommand" Background="Transparent"/>
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ComicToggle" TargetType="ToggleButton">
    <Setter Property="Width" Value="64"/>
    <Setter Property="Height" Value="34"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid>
            <Border x:Name="SwitchBack" CornerRadius="18" Background="#BDBDBD" BorderBrush="{StaticResource ComicInkBrush}" BorderThickness="2"/>
            <Ellipse x:Name="Knob" Width="28" Height="28" Fill="White" Stroke="{StaticResource ComicInkBrush}" StrokeThickness="2" Margin="3" HorizontalAlignment="Left"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="SwitchBack" Property="Background" Value="{StaticResource ComicAccentGreenBrush}"/>
              <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="SwitchBack" Property="Opacity" Value="0.95"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ComicPanel simple helper style: interior padding and title -->
  <Style x:Key="ComicSectionPanel" TargetType="Border" BasedOn="{StaticResource ComicPanelStyle}"/>

</ResourceDictionary>