<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Comic theme tokens -->
  <!-- Merge icon drawing resources (moved to top to ensure merged dictionaries are declared before content) -->
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Assets/Icons/pow_drawing.xaml" />
    <ResourceDictionary Source="/Assets/Icons/fist_thumb_drawing.xaml" />
    <ResourceDictionary Source="/Assets/ComicTheme/pow_high_drawing.xaml" />
    <ResourceDictionary Source="/Assets/ComicTheme/ribbon_header_drawing.xaml" />
    <ResourceDictionary Source="/Assets/ComicTheme/pin_tack_drawing.xaml" />
    <ResourceDictionary Source="/Assets/ComicTheme/ben_day_tile_drawing.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Color x:Key="ComicBackgroundColor">#0A0A0A</Color>
  <Color x:Key="ComicPanelColor">#FFFDF2</Color>
  <Color x:Key="ComicAccentOrange">#FF5A00</Color>
  <Color x:Key="ComicAccentYellow">#FFCC00</Color>
  <Color x:Key="ComicAccentGreen">#16C784</Color>
  <Color x:Key="ComicAccentBlue">#5E4CFF</Color>
  <Color x:Key="ComicInk">#000000</Color>

  <SolidColorBrush x:Key="ComicBackgroundBrush" Color="{StaticResource ComicBackgroundColor}"/>
  <SolidColorBrush x:Key="ComicPanelBrush" Color="{StaticResource ComicPanelColor}"/>
  <SolidColorBrush x:Key="ComicAccentBrush" Color="{StaticResource ComicAccentOrange}"/>
  <SolidColorBrush x:Key="ComicAccentYellowBrush" Color="{StaticResource ComicAccentYellow}"/>
  <SolidColorBrush x:Key="ComicAccentGreenBrush" Color="{StaticResource ComicAccentGreen}"/>
  <SolidColorBrush x:Key="ComicAccentBlueBrush" Color="{StaticResource ComicAccentBlue}"/>
  <SolidColorBrush x:Key="ComicInkBrush" Color="{StaticResource ComicInk}"/>

  <!-- Fonts (fallback a Segoe UI si no hay fuentes cómic instaladas) -->
  <FontFamily x:Key="ComicDisplayFont">Bangers, Segoe UI, Arial</FontFamily>
  <FontFamily x:Key="ComicPrimaryFont">Comic Neue, Segoe UI, Arial</FontFamily>

  <!-- Panel style: borde de tinta grueso y fondo papel -->
  <Style x:Key="ComicPanelStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource ComicPanelBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource ComicInkBrush}"/>
    <Setter Property="BorderThickness" Value="6"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="18"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>


  <!-- Navigation badge button -->
  <Style x:Key="NavigationBadgeButton" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource ComicPrimaryFont}"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="Background" Value="{StaticResource ComicBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource ComicInkBrush}"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="Width" Value="84"/>
    <Setter Property="Height" Value="84"/>
    <Setter Property="Padding" Value="6"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="InkBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
              <Grid>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <!-- Active burst placeholder (collapsed by default) -->
            <Path x:Name="Burst" Fill="{StaticResource ComicAccentYellowBrush}" Opacity="0" Stretch="Uniform" Data="M0,8 L6,10 L8,0 L10,10 L16,8 L10,12 L12,22 L8,14 L4,22 L6,12 Z" RenderTransformOrigin="0.5,0.5"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="InkBorder" Property="Opacity" Value="0.92"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="InkBorder" Property="RenderTransform">
                <Setter.Value>
                  <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="Tag" Value="Active">
              <Setter TargetName="Burst" Property="Opacity" Value="1"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Explosion action button (global actions) -->
  <Style x:Key="ExplosionActionButton" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource ComicDisplayFont}"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="Background" Value="{StaticResource ComicAccentGreenBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource ComicInkBrush}"/>
    <Setter Property="BorderThickness" Value="3"/>
    <Setter Property="Padding" Value="10,8"/>
    <Setter Property="MinWidth" Value="120"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Path x:Name="Spikes" Data="M0,10 L6,4 L10,10 L16,2 L22,10 L16,14 L22,22 L10,16 L-2,22 L4,14 Z" Fill="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}" Opacity="0.08" Stretch="Uniform"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Opacity" Value="0.98"/>
              <Setter TargetName="Root" Property="RenderTransform">
                <Setter.Value>
                  <TranslateTransform X="0" Y="-2"/>
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="RenderTransform">
                <Setter.Value>
                  <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                </Setter.Value>
              </Setter>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>