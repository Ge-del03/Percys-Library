<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Paleta principal para la sección de estadísticas -->
    <Color x:Key="RS_AppBackgroundColor">#0F1824</Color>
    <Color x:Key="RS_SurfaceColor">#162132</Color>
    <Color x:Key="RS_SurfaceElevated">#1F2D41</Color>
    <Color x:Key="RS_TextPrimary">#F4F7FF</Color>
    <Color x:Key="RS_TextSecondary">#AFC4DA</Color>
    <Color x:Key="RS_Accent">#FF1EA7FF</Color>
    <Color x:Key="RS_Success">#FF2CD880</Color>
    <Color x:Key="RS_Warning">#FFFFC75F</Color>
    <Color x:Key="RS_Danger">#FFFF6B6B</Color>

    <SolidColorBrush x:Key="RS_AppBackgroundBrush" Color="{StaticResource RS_AppBackgroundColor}"/>
    <SolidColorBrush x:Key="RS_SurfaceBrush" Color="{StaticResource RS_SurfaceColor}"/>
    <SolidColorBrush x:Key="RS_SurfaceElevatedBrush" Color="{StaticResource RS_SurfaceElevated}"/>
    <SolidColorBrush x:Key="RS_TextOnDarkBrush" Color="{StaticResource RS_TextPrimary}"/>
    <SolidColorBrush x:Key="RS_TextMutedBrush" Color="{StaticResource RS_TextSecondary}"/>
    <SolidColorBrush x:Key="RS_AccentBrush" Color="{StaticResource RS_Accent}"/>
    <SolidColorBrush x:Key="RS_SuccessBrush" Color="{StaticResource RS_Success}"/>
    <SolidColorBrush x:Key="RS_WarningBrush" Color="{StaticResource RS_Warning}"/>
    <SolidColorBrush x:Key="RS_DangerBrush" Color="{StaticResource RS_Danger}"/>

    <LinearGradientBrush x:Key="RS_HeroGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#332E4F" Offset="0"/>
        <GradientStop Color="#19253A" Offset="0.4"/>
        <GradientStop Color="#112033" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="RS_StatCardGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#252F41" Offset="0"/>
        <GradientStop Color="#1B2738" Offset="1"/>
    </LinearGradientBrush>

    <!-- Tokens tipográficos y de layout -->
    <sys:Double x:Key="RS_StatValueSize">24</sys:Double>
    <sys:Double x:Key="RS_StatLabelSize">13</sys:Double>
    <CornerRadius x:Key="RS_CardCorner">14</CornerRadius>

    <!-- Estilo base para tarjetas pequeñas -->
    <Style x:Key="RS_StatCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource RS_StatCardGradient}"/>
        <Setter Property="CornerRadius" Value="{StaticResource RS_CardCorner}"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#1F2D41" BlurRadius="16" Opacity="0.35" ShadowDepth="0"/>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush" Value="#3340566A"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="RS_ElevatedCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource RS_SurfaceElevatedBrush}"/>
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="Padding" Value="18"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#101521" BlurRadius="22" Opacity="0.45" ShadowDepth="0"/>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush" Value="#3340566A"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- ProgressBar estilizada para el panel de progreso -->
    <Style x:Key="RS_ProgressBarStyle" TargetType="ProgressBar">
        <Setter Property="Height" Value="12"/>
        <Setter Property="Background" Value="#1B2738"/>
        <Setter Property="Foreground" Value="{StaticResource RS_AccentBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                        <Grid>
                            <Rectangle x:Name="PART_Indicator" Fill="{TemplateBinding Foreground}" RadiusX="6" RadiusY="6" HorizontalAlignment="Left"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Value" Value="0">
                            <Setter TargetName="PART_Indicator" Property="Width" Value="0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
