<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Color tokens para la sección de Estadísticas de Lectura -->
    <Color x:Key="RS_AppBackgroundColor">#FF16202A</Color>
    <Color x:Key="RS_CardBackgroundColorLight">#FFFFFFFF</Color>
    <Color x:Key="RS_CardBackgroundColorDark">#FF2F3A42</Color>
    <Color x:Key="RS_TextOnDark">#FFFFFFFF</Color>
    <Color x:Key="RS_Accent">#FF1EA7FF</Color>
    <Color x:Key="RS_Success">#FF28C76F</Color>
    <Color x:Key="RS_Warning">#FFFFB020</Color>
    <Color x:Key="RS_Danger">#FFFF6B6B</Color>

    <SolidColorBrush x:Key="RS_AppBackgroundBrush" Color="{StaticResource RS_AppBackgroundColor}"/>
    <SolidColorBrush x:Key="RS_CardBackgroundBrush" Color="{StaticResource RS_CardBackgroundColorDark}"/>
    <SolidColorBrush x:Key="RS_CardBackgroundBrushLight" Color="{StaticResource RS_CardBackgroundColorLight}"/>
    <SolidColorBrush x:Key="RS_TextOnDarkBrush" Color="{StaticResource RS_TextOnDark}"/>
    <SolidColorBrush x:Key="RS_AccentBrush" Color="{StaticResource RS_Accent}"/>
    <SolidColorBrush x:Key="RS_SuccessBrush" Color="{StaticResource RS_Success}"/>
    <SolidColorBrush x:Key="RS_WarningBrush" Color="{StaticResource RS_Warning}"/>
    <SolidColorBrush x:Key="RS_DangerBrush" Color="{StaticResource RS_Danger}"/>

    <!-- Tokens tipográficos y de layout -->
    <sys:Double x:Key="RS_StatValueSize" xmlns:sys="clr-namespace:System;assembly=mscorlib">22</sys:Double>
    <sys:Double x:Key="RS_StatLabelSize" xmlns:sys="clr-namespace:System;assembly=mscorlib">13</sys:Double>
    <CornerRadius x:Key="RS_CardCorner">6</CornerRadius>

    <!-- Estilo base para tarjetas pequeñas -->
    <Style x:Key="RS_StatCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource RS_CardBackgroundBrush}"/>
        <Setter Property="CornerRadius" Value="{StaticResource RS_CardCorner}"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#000000" BlurRadius="10" Opacity="0.18"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ProgressBar simple template usado por ProgressComicItem -->
    <Style x:Key="RS_ProgressBarStyle" TargetType="ProgressBar">
        <Setter Property="Height" Value="14"/>
        <Setter Property="Background" Value="#FF2F353B"/>
        <Setter Property="Foreground" Value="{StaticResource RS_AccentBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{TemplateBinding Background}" CornerRadius="4">
                        <Grid>
                            <Rectangle x:Name="PART_Indicator" Fill="{TemplateBinding Foreground}" RadiusX="4" RadiusY="4" HorizontalAlignment="Left"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Value" Value="0">
                            <Setter TargetName="PART_Indicator" Property="Width" Value="0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
