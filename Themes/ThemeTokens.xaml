<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Paleta Obsidian Fluent Dark -->
  <Color x:Key="Color.AppSurface">#0F1115</Color>
  <Color x:Key="Color.Sidebar">#151820</Color>
  <Color x:Key="Color.Panel">#161920</Color>
  <Color x:Key="Color.Card">#1C202B</Color>
  <Color x:Key="Color.CardHoverBorder">#6366F1</Color>
  <Color x:Key="Color.PrimaryAccent">#6366F1</Color>
  <Color x:Key="Color.PrimaryAccentHover">#4F46E5</Color>

  <Color x:Key="Color.Status.Reading">#3B82F6</Color>
  <Color x:Key="Color.Status.Completed">#10B981</Color>
  <Color x:Key="Color.Status.Unread">#64748B</Color>

  <Color x:Key="Color.Text.Primary">#F8FAFC</Color>
  <Color x:Key="Color.Text.Secondary">#94A3B8</Color>
  <Color x:Key="Color.Border">#2A2E3D</Color>
  <Color x:Key="Color.Glass">#CC151820</Color>

  <!-- Compatibilidad / Pinceles Estándar -->
  <Color x:Key="Color.Primary.Blue">#6366F1</Color>
  <Color x:Key="Color.Primary.Red">#EF4444</Color>
  <Color x:Key="Color.Primary.Yellow">#F59E0B</Color>
  <Color x:Key="Color.Primary.Orange">#F97316</Color>
  <Color x:Key="Color.Primary.Purple">#8B5CF6</Color>
  <Color x:Key="Color.Primary.Green">#10B981</Color>

  <Color x:Key="Color.Neutral.Dark">#0F1115</Color>
  <Color x:Key="Color.Neutral.Mid">#161920</Color>
  <Color x:Key="Color.Neutral.Light">#2A2E3D</Color>
  <Color x:Key="Color.Neutral.SoftWhite">#F8FAFC</Color>
  <Color x:Key="Color.Neutral.OffWhite">#94A3B8</Color>
  <Color x:Key="Color.Background.Deep">#0F1115</Color>
  <Color x:Key="Color.Background.Card">#1C202B</Color>
  <Color x:Key="Color.Background.Panel">#161920</Color>

  <!-- Brushes -->
  <SolidColorBrush x:Key="AppSurfaceBackground" Color="{StaticResource Color.AppSurface}"/>
  <SolidColorBrush x:Key="SidebarBackground" Color="{StaticResource Color.Sidebar}"/>
  <SolidColorBrush x:Key="PanelBackground" Color="{StaticResource Color.Panel}"/>
  <SolidColorBrush x:Key="CardBackground" Color="{StaticResource Color.Card}"/>
  <SolidColorBrush x:Key="CardHoverBorder" Color="{StaticResource Color.CardHoverBorder}"/>
  <SolidColorBrush x:Key="PrimaryAccent" Color="{StaticResource Color.PrimaryAccent}"/>
  <SolidColorBrush x:Key="PrimaryAccentHover" Color="{StaticResource Color.PrimaryAccentHover}"/>
  <SolidColorBrush x:Key="GlassBackground" Color="{StaticResource Color.Glass}"/>

  <SolidColorBrush x:Key="StatusReadingBrush" Color="{StaticResource Color.Status.Reading}"/>
  <SolidColorBrush x:Key="StatusCompletedBrush" Color="{StaticResource Color.Status.Completed}"/>
  <SolidColorBrush x:Key="StatusUnreadBrush" Color="{StaticResource Color.Status.Unread}"/>

  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource Color.Text.Primary}"/>
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource Color.Text.Secondary}"/>
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Color.Border}"/>

  <!-- Aliases para compatibilidad con código existente -->
  <SolidColorBrush x:Key="Brush.Primary" Color="{StaticResource Color.PrimaryAccent}"/>
  <SolidColorBrush x:Key="Brush.Primary.Accent" Color="{StaticResource Color.PrimaryAccent}"/>
  <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Primary.Red}"/>
  <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Status.Completed}"/>
  <SolidColorBrush x:Key="Brush.Window" Color="{StaticResource Color.AppSurface}"/>
  <SolidColorBrush x:Key="Brush.Card" Color="{StaticResource Color.Card}"/>
  <SolidColorBrush x:Key="Brush.Panel" Color="{StaticResource Color.Panel}"/>
  <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text.Primary}"/>
  <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.Text.Secondary}"/>
  <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}"/>

  <LinearGradientBrush x:Key="Brush.Header.Gradient" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#6366F1" Offset="0"/>
    <GradientStop Color="#8B5CF6" Offset="0.5"/>
    <GradientStop Color="#3B82F6" Offset="1"/>
  </LinearGradientBrush>
</ResourceDictionary>