<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Comic palette -->
    <Color x:Key="ComicBg">#FFFDF2E6</Color>
    <Color x:Key="ComicAccent">#FFD95B2A</Color>
    <Color x:Key="ComicText">#3b2e2e</Color>

    <SolidColorBrush x:Key="ComicBackgroundBrush" Color="{StaticResource ComicBg}" />
    <SolidColorBrush x:Key="ComicAccentBrush" Color="{StaticResource ComicAccent}" />
    <SolidColorBrush x:Key="ComicTextBrush" Color="{StaticResource ComicText}" />

    <Style x:Key="ComicButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#FFFCF0E6" />
        <Setter Property="BorderBrush" Value="#FFD4B29A" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource ComicTextBrush}" />
    </Style>

    <Style x:Key="ComicAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource ComicButtonStyle}">
        <Setter Property="Background" Value="{StaticResource ComicAccentBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

</ResourceDictionary>
