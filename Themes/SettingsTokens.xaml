<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <!-- Colors -->
  <Color x:Key="BgMainColor">#0B0E18</Color>
  <Color x:Key="PanelLeftColor">#0F1722</Color>
  <Color x:Key="CardBgColor">#151A28</Color>
  <Color x:Key="Accent1Color">#FFAA00</Color>
  <Color x:Key="Accent2Color">#0056FF</Color>
  <Color x:Key="TextPrimaryColor">#EDEDED</Color>
  <Color x:Key="TextMutedColor">#AEB6C0</Color>

  <SolidColorBrush x:Key="BgMainBrush" Color="{StaticResource BgMainColor}" />
  <SolidColorBrush x:Key="PanelLeftBrush" Color="{StaticResource PanelLeftColor}" />
  <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource CardBgColor}" />
  <SolidColorBrush x:Key="Accent1Brush" Color="{StaticResource Accent1Color}" />
  <SolidColorBrush x:Key="Accent2Brush" Color="{StaticResource Accent2Color}" />
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

  <!-- Radii -->
  <CornerRadius x:Key="CardCorner">18</CornerRadius>
  <CornerRadius x:Key="ButtonCorner">12</CornerRadius>

  <!-- Durations -->
  <sys:Int32 x:Key="AnimMicro">120</sys:Int32>

</ResourceDictionary>
